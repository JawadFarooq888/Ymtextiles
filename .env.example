# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler"), used at runtime.
# Append &pgbouncer=true&connect_timeout=15&pool_timeout=30 for Prisma with Neon pooling
# (Neon free tier sleeps when idle; these give it time to wake up).
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma migrations
DIRECT_URL=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Site ---
# e.g. https://ymtextiles.co.uk (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "YM Textiles <orders@ymtextiles.co.uk>".
# Without it, Resend's test sender is used (it can only email your own Resend account address).
EMAIL_FROM=
# Address that receives new-order alerts
ADMIN_ALERT_EMAIL=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Cron (sent as Bearer token to /api/cron/*) ---
CRON_SECRET=

# --- First admin account created by `npm run db:seed` ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
