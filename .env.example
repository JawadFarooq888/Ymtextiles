# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler"), used at runtime
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma migrations
DIRECT_URL=

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Site ---
# e.g. https://ymtextiles.co.uk (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# Address that receives new-order alerts
ADMIN_ALERT_EMAIL=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Cron (sent as Bearer token to /api/cron/*) ---
CRON_SECRET=

# --- First admin account created by `npm run db:seed` ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
