generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DIRECT_URL") // Neon direct connection (migrations)
}

// All money fields are integer pence.

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  STITCHED
  UNSTITCHED
}

enum OrderChannel {
  WEBSITE
  WHATSAPP
}

enum OrderStatus {
  PENDING
  AWAITING_WHATSAPP_CONFIRMATION
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BannerPlacement {
  HERO
  ANNOUNCEMENT
}

// ---------- Catalogue ----------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, sortOrder])
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  sku            String         @unique
  description    String         @default("") // rich text (HTML)
  careDetails    String?
  fabric         String? // Denim composition, e.g. "98% cotton, 2% elastane"
  fit            String? // Skinny, Slim, Straight, Relaxed, Bootcut, Wide leg, Mom...
  rise           String? // Low, Mid, High
  stretch        String? // No stretch, Comfort stretch, Super stretch
  // Not used for jeans; kept so older data and CSV files still load.
  pieces         Int?
  type           ProductType    @default(STITCHED)
  basePrice      Int
  salePrice      Int?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeChartId    String?
  sizeChart      SizeChart?     @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  tags           String[]       @default([])
  isFeatured     Boolean        @default(false)
  isBestSeller   Boolean        @default(false)
  isNew          Boolean        @default(false)
  isActive       Boolean        @default(true)
  seoTitle       String?
  seoDescription String?
  images         ProductImage[]
  variants       Variant[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary public id, used for deletion and transformations
  alt       String   @default("")
  sortOrder Int      @default(0)
  colourId  String? // optional: selecting this colour switches the gallery
  colour    Colour?  @relation(fields: [colourId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Size {
  id        String    @id @default(cuid())
  label     String    @unique // e.g. "W32 L30", or "7-8Y" for kids
  // Jeans sizing in inches. Both set = shown as separate Waist and Length choices.
  waist     Int?
  length    Int?
  sortOrder Int       @default(0)
  variants  Variant[]
}

model Colour {
  id       String         @id @default(cuid())
  name     String         @unique
  hex      String
  variants Variant[]
  images   ProductImage[]
}

model Variant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId        String
  size          Size        @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  colourId      String
  colour        Colour      @relation(fields: [colourId], references: [id], onDelete: Restrict)
  sku           String      @unique
  stock         Int         @default(0)
  priceOverride Int?
  isActive      Boolean     @default(true)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, sizeId, colourId])
  @@index([stock])
}

model SizeChart {
  id        String    @id @default(cuid())
  name      String    @unique
  // Column names in order, e.g. ["Waist", "Hip", "Inside leg", "Front rise", "Leg opening"].
  columns   Json      @default("[]")
  // Array of rows: { size: string, values: (number | null)[] } in inches, one value per column.
  // Centimetres are worked out for display.
  rows      Json
  notes     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------- Orders ----------

model Order {
  id                    String       @id @default(cuid())
  // Human-friendly reference such as YM-10234, generated from a Postgres sequence.
  orderNumber           String       @unique @default(dbgenerated("('YM-'::text || nextval('order_number_seq'::regclass))"))
  // Unguessable token for the private /order/[token] summary page (256 random bits).
  publicToken           String       @unique @default(dbgenerated("replace(((gen_random_uuid())::text || (gen_random_uuid())::text), '-'::text, ''::text)"))
  channel               OrderChannel
  status                OrderStatus  @default(PENDING)
  userId                String?
  user                  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String?
  email                 String?
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  postcode              String?
  country               String       @default("GB")
  subtotal              Int
  deliveryFee           Int          @default(0)
  deliveryMethod        String?
  discount              Int          @default(0)
  total                 Int
  stripeSessionId       String?      @unique
  stripePaymentIntentId String?
  // Set once stock has been deducted, so webhooks and confirmations are idempotent.
  stockDeductedAt       DateTime?
  notes                 String?
  adminNotes            String?
  items                 OrderItem[]
  paidAt                DateTime?
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([channel, status, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshots at order time, so later catalogue edits don't change past orders.
  productName String
  productSlug String?
  sku         String
  size        String
  colour      String
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  @@index([orderId])
}

// ---------- Content and settings ----------

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  ctaText   String?
  ctaUrl    String?
  placement BannerPlacement @default(HERO)
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

// Single row (id = 1). Every business value is editable from the admin panel.
model Settings {
  id                    Int      @id @default(1)
  storeName             String   @default("YM Textiles")
  whatsappNumber        String // E.164 without "+", e.g. 447XXXXXXXXX
  whatsappGreeting      String   @default("Hi YM Textiles, I would like to order:")
  freeDeliveryThreshold Int // pence
  standardDeliveryFee   Int // pence
  expressDeliveryFee    Int // pence
  announcementText      String?
  contactEmail          String?
  instagramUrl          String?
  tiktokUrl             String?
  facebookUrl           String?
  businessAddress       String?
  returnsDays           Int      @default(14)
  lowStockThreshold     Int      @default(3)
  // WhatsApp orders: when false, customers outside the UK can order (postcode/town is free text).
  whatsappUkOnly        Boolean  @default(true)
  // Shop text
  footerTagline         String   @default("Jeans for men, women and kids, stocked in the UK.")
  dispatchInfo          String? // e.g. "Orders are dispatched within 2 working days"
  // Array of { title, text } for the home page "Why YM Textiles" section; null = defaults.
  whyUs                 Json?
  // Search engines
  seoTitle              String   @default("YM Textiles | Jeans for Men, Women & Kids")
  seoDescription        String   @default("Jeans for men, women and kids in every fit: skinny, slim, straight and wide leg. Find your waist and length. UK delivery.")
  // Header menu shortcuts
  menuShowNewIn         Boolean  @default(true)
  menuShowBestSellers   Boolean  @default(true)
  // Legacy (from the clothing version); unused. Kept so deploys never break the live site.
  menuShowLawn          Boolean  @default(true)
  menuShowSale          Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// Editable information pages (About, Delivery & Returns, Privacy...).
// Body uses simple formatting: "## Heading", "- list item", blank line = new paragraph, [text](https://link).
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  body            String   @default("")
  metaDescription String?
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentAt      DateTime
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
